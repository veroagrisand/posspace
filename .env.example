# ===== Backend: Supabase (wajib untuk produksi) =====
# Dari dashboard Supabase: Project Settings > API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ===== Identitas usaha publik (halaman Kontak & verifikasi iPaymu) =====
PUBLIC_BUSINESS_EMAIL=info@posspace.id
PUBLIC_BUSINESS_PHONE="+62 812-3456-7890"
PUBLIC_BUSINESS_ADDRESS="KOST.ON 3 Residence, Jalan Purawinata, Paledang, Lengkong, Kota Bandung 40261"

# Rahasia server (HANYA di server — jangan pakai prefix PUBLIC_)
# Service role key: Project Settings > API > service_role
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Pembayaran: iPaymu (VA, QRIS, e-wallet) =====
# Daftar di https://my.ipaymu.com → menu Integrasi untuk mendapatkan VA & API Key.
# Mode sandbox dan produksi memakai VA/API Key yang BERBEDA.
IPAYMU_VA=
IPAYMU_API_KEY=
# Base URL: sandbox (uji coba) — ganti ke https://my.ipaymu.com untuk produksi
IPAYMU_BASE_URL=https://sandbox.ipaymu.com

# ===== Email OTP registrasi: SMTP Hostinger =====
# Buat email di hPanel Hostinger: Emails → buat akun (mis. no-reply@domainanda.id)
SMTP_HOST=smtp.hostinger.com
# 465 = SSL (secure=true), 587 = STARTTLS (secure=false)
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@domainanda.id
SMTP_PASS=
# Pengirim tampilan (boleh sama dengan SMTP_USER)
SMTP_FROM="posspace <no-reply@domainanda.id>"

# OTP: 6 digit, masa berlaku (menit), percobaan maksimal 5x, cooldown kirim 60 detik
OTP_TTL_MINUTES=10
# HANYA untuk pengembangan lokal: jika true, kode OTP ikut dikembalikan
# di respons API sehingga bisa diuji tanpa email sungguhan. WAJIB false di produksi.
ALLOW_OTP_DEBUG=false

# ===== Mode pengembangan (WAJIB false di produksi) =====
# Mode demo tanpa Supabase: HANYA untuk pengembangan lokal.
# Saat false dan Supabase belum dikonfigurasi, aplikasi dialihkan ke /setup.
ALLOW_DEMO_MODE=false

# Simulasi pembayaran (tanpa gateway): HANYA untuk pengembangan lokal.
# Saat true, endpoint /api/payments/mock bisa menandai invoice lunas.
# WAJIB false di produksi agar alur pembayaran tidak bisa di-bypass.
ALLOW_MOCK_PAYMENT=false

# Aktivasi langganan manual (TANPA gateway): pemilik toko bisa mengaktifkan
# langganan sendiri lewat /api/subscription/activate (server-side, hanya pemilik).
# Ini JALUR SEMENTARA sampai iPaymu diaktifkan — WAJIB false di produksi.
ALLOW_MANUAL_ACTIVATION=false

# ===== Arsitektur microservices (frontend ↔ API gateway) =====
# Alamat internal API gateway (apps/api). Frontend mem-proxy /api/* ke sini.
# Di VPS: kedua proses di mesin yang sama — biarkan 127.0.0.1:3001.
API_UPSTREAM=http://127.0.0.1:3001

# Port yang dipakai masing-masing proses (web = adapter-node PORT, api = PORT).
# Di VPS dengan Nginx: web 3000, api 3001 (internal, tidak dibuka ke publik).
PORT=3000
API_PORT=3001
